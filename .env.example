PORT=8080
# Convert Supabase's postgresql:// connection string to jdbc:postgresql://.
# If your password contains special characters, URL-encode it before placing it here.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?user=postgres.your-project-ref&password=your-supabase-db-password&sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://animesh292.github.io
